CONFIG_PACKAGE_kmod-nf-conntrack-bridge=y
CONFIG_PACKAGE_kmod-nf-flow=y
CONFIG_PACKAGE_kmod-nft-bridge=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_mount-utils=y
CONFIG_PACKAGE_kmod-sched-cake=y
CONFIG_PACKAGE_kmod-tcp-bbr=y
# 透明代理：每套只编一个变体，配置在 configs/variants/ 下，由 release.yml 按变体追加
#   nikki     → mihomo（Mihomo Meta / Nikki）
#   homeproxy → sing-box（HomeProxy）
#   dae       → daed（dae 的仪表盘版，eBPF）
# 无线/USB：只有 XG-040G-MD / MF 两个机型，本机没有 Wi-Fi 硬件，也不做 USB 共享
# CONFIG_PACKAGE_libiwinfo is not set
# CONFIG_PACKAGE_libiwinfo-data is not set
# CONFIG_PACKAGE_rpcd-mod-iwinfo is not set
# CONFIG_PACKAGE_kmod-mac80211 is not set
# CONFIG_PACKAGE_kmod-mt76-core is not set
# CONFIG_PACKAGE_kmod-mt76-connac is not set
# CONFIG_PACKAGE_kmod-mt7915e is not set
# CONFIG_PACKAGE_wpad-openssl is not set
# CONFIG_PACKAGE_hostapd-common is not set
# CONFIG_PACKAGE_wireless-regdb is not set
# USB：不需要 USB 共享
# CONFIG_PACKAGE_kmod-usb-core is not set
# CONFIG_PACKAGE_kmod-usb-common is not set
# CONFIG_PACKAGE_kmod-usb3 is not set
# CONFIG_PACKAGE_kmod-usb-xhci-hcd is not set
# CONFIG_PACKAGE_kmod-usb-storage is not set
# CONFIG_PACKAGE_kmod-usb-storage-uas is not set
# CONFIG_PACKAGE_kmod-usb-ledtrig-usbport is not set
# CONFIG_PACKAGE_kmod-fs-ext4 is not set
# CONFIG_PACKAGE_kmod-fs-vfat is not set
# CONFIG_PACKAGE_kmod-fs-exfat is not set
# NPU 状态监控（Airoha SoC Status，由 release.yml 引入）
CONFIG_PACKAGE_luci-app-airoha-npu=y
# 编译器缓存：配合 workflow 里的 .ccache 缓存，重复构建时命中已编译对象
CONFIG_CCACHE=y
CONFIG_CCACHE_DIR=""
